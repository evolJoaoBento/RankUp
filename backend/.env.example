# Copy to .env and adjust.
MECATECA_ENV=dev
MECATECA_DATABASE_URL=postgresql+asyncpg://mecateca:mecateca@localhost:5432/mecateca
MECATECA_JWT_SECRET=dev-secret-change-me
MECATECA_JWT_ACCESS_TTL_MIN=15
MECATECA_JWT_REFRESH_TTL_DAYS=30
MECATECA_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# LLM backend: gateway (local Claude CLI, default) | ollama | anthropic | fake
MECATECA_LLM_BACKEND=gateway
MECATECA_GATEWAY_BASE_URL=http://localhost:8010/v1
MECATECA_GATEWAY_MODEL=          # empty = CLI default; or claude-sonnet-4-5-20250929
MECATECA_OLLAMA_BASE_URL=http://localhost:11434
MECATECA_OLLAMA_MODEL=qwen3:4b  # fits 8GB GPUs; qwen3:8b for >=12GB VRAM
MECATECA_OLLAMA_THINK=auto      # auto|on|off — auto disables qwen3 thinking tags
# (alternatives: qwen3:8b · llama3.1:8b · qwen2.5:7b-instruct)

# Only used when MECATECA_LLM_BACKEND=anthropic
ANTHROPIC_API_KEY=

# Free-plan caps
MECATECA_FREE_TUTOR_MSGS_PER_DAY=20

# Seed the demo discipline (Philosophy) at boot — set 0 for real deployments
MECATECA_SEED_DEMO=1
